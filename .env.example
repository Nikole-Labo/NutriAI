USDA_FDC_API_KEY=your_fdc_api_key_here
HF_TOKEN=your_huggingface_token_here

# --- Qdrant Cloud (Stage 2) — primary configuration -------------------------
# In the Qdrant Cloud console: Cluster → copy "Endpoint" / REST URL and API key.
# Paste the full HTTPS URL (include :6333 only if the console shows it on the URL).
QDRANT_URL=https://YOUR-CLUSTER-ID.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# --- Qdrant local (optional dev only) --------------------------------------
# If QDRANT_URL is unset, scripts use host + port instead (Docker on your PC).
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
